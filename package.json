{
  "name": "github-contributions-3d",
  "version": "1.0.0",
  "description": "Turn your GitHub contribution graph into an animated 3D GIF for your profile README. Regenerated daily by GitHub Actions and published on GitHub Pages.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "generate": "npm run build && node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "github",
    "github-profile",
    "github-profile-readme",
    "profile-readme",
    "github-contributions",
    "contribution-graph",
    "github-contribution-graph",
    "3d",
    "isometric",
    "animated-gif",
    "gif",
    "visualization",
    "github-actions",
    "github-pages",
    "typescript",
    "node-canvas"
  ],
  "author": "funayamateppei",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "canvas": "^3.2.3",
    "dotenv": "^17.2.3",
    "gifencoder": "^2.0.1"
  },
  "devDependencies": {
    "@types/gifencoder": "^2.0.3",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "gifencoder": {
      "canvas": "$canvas"
    }
  },
  "homepage": "https://funayamateppei.github.io/github-contributions-3d/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funayamateppei/github-contributions-3d.git"
  },
  "bugs": {
    "url": "https://github.com/funayamateppei/github-contributions-3d/issues"
  }
}
